# Copy to .env (never commit .env). Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# URL nginx uses to reach the Django API inside the compose network
API_URL=http://backend:8000
# Host port that serves the app
HTTP_PORT=80
# Docker Hub namespace used for pulling/pushing images (CI/CD sets this)
DOCKERHUB_USER=local
IMAGE_TAG=latest
